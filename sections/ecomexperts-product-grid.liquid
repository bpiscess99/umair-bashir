{{ 'ecomexperts-assessment.css' | asset_url | stylesheet_tag }}

{% assign bonus_variant = section.settings.bonus_product.selected_or_first_available_variant %}


<section 
class="ee-product-grid"
data-ee-bonus-variant-id="{{ bonus_variant.id }}"
>

  <h2 class="ee-product-grid__heading">
    {{ section.settings.heading }}
  </h2>


  {% comment %}
    =========================================================
    PRODUCT GRID

    Six products are selected individually from the
    Shopify Theme Customizer.

    This directly follows the assessment requirement:
    "six blocks, each for one product, and the products
    should be selectable from the customizer"
    =========================================================
  {% endcomment %}

  <div class="ee-product-grid__items">

    {% for i in (1..6) %}

      {% capture product_setting_id %}
        product_{{ i }}
      {% endcapture %}

      {% assign product_setting_id = product_setting_id | strip %}
      {% assign product = section.settings[product_setting_id] %}

      {% if product != blank %}

        {% assign selected_variant = product.selected_or_first_available_variant %}

        <div class="ee-product-grid__item">

          {% if product.featured_image != blank %}
            {{
              product.featured_image
              | image_url: width: 900
              | image_tag:
                class: 'ee-product-grid__image',
                loading: 'lazy',
                alt: product.title
            }}
          {% endif %}


          {% comment %}
            Exact Figma hotspot positions
          {% endcomment %}

          {% case i %}

            {% when 1 %}
              {% assign hotspot_x = '61.8%' %}
              {% assign hotspot_y = '56.1%' %}

            {% when 2 %}
              {% assign hotspot_x = '84.6%' %}
              {% assign hotspot_y = '52.5%' %}

            {% when 3 %}
              {% assign hotspot_x = '63%' %}
              {% assign hotspot_y = '21%' %}

            {% when 4 %}
              {% assign hotspot_x = '72.2%' %}
              {% assign hotspot_y = '18.5%' %}

            {% when 5 %}
              {% assign hotspot_x = '51.6%' %}
              {% assign hotspot_y = '25.9%' %}

            {% when 6 %}
              {% assign hotspot_x = '76.3%' %}
              {% assign hotspot_y = '39.4%' %}

          {% endcase %}


          <button
            type="button"
            class="ee-product-grid__hotspot"
            aria-label="View {{ product.title | escape }}"
            data-ee-open-modal="ee-product-modal-{{ section.id }}-{{ i }}-{{ product.id }}"
            style="
              --ee-hotspot-x: {{ hotspot_x }};
              --ee-hotspot-y: {{ hotspot_y }};
            "
          >
            +
          </button>

        </div>

      {% endif %}

    {% endfor %}

  </div>


  {% comment %}
    =========================================================
    PRODUCT QUICK VIEW MODALS
    =========================================================
  {% endcomment %}

  {% for i in (1..6) %}

    {% capture product_setting_id %}
      product_{{ i }}
    {% endcapture %}

    {% assign product_setting_id = product_setting_id | strip %}
    {% assign product = section.settings[product_setting_id] %}

    {% if product != blank %}

      {% assign selected_variant = product.selected_or_first_available_variant %}

      <div
        class="ee-product-modal"
        id="ee-product-modal-{{ section.id }}-{{ i }}-{{ product.id }}"
        hidden
      >

        <button
          type="button"
          class="ee-product-modal__overlay"
          aria-label="Close product"
          data-ee-close-modal
        ></button>


        <div
          class="ee-product-modal__dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="ee-product-title-{{ section.id }}-{{ i }}-{{ product.id }}"
        >

          <button
            type="button"
            class="ee-product-modal__close"
            aria-label="Close"
            data-ee-close-modal
          >
            ×
          </button>


          {% comment %}
            =================================================
            PRODUCT INFORMATION
            =================================================
          {% endcomment %}

          <div class="ee-product-modal__top">

            {% if product.featured_image != blank %}

              {{
                product.featured_image
                | image_url: width: 400
                | image_tag:
                  class: 'ee-product-modal__image',
                  loading: 'lazy',
                  alt: product.title
              }}

            {% endif %}


            <div class="ee-product-modal__info">

              <h3
                class="ee-product-modal__title"
                id="ee-product-title-{{ section.id }}-{{ i }}-{{ product.id }}"
              >
                {{ product.title }}
              </h3>


              <div
                class="ee-product-modal__price"
                data-ee-product-price
              >
                {{ selected_variant.price | money }}
              </div>


              <div class="ee-product-modal__description">
                {{ product.description | strip_html | truncate: 140 }}
              </div>

            </div>

          </div>


          {% comment %}
            =================================================
            PRODUCT OPTIONS
            =================================================
          {% endcomment %}

          <div class="ee-product-modal__options">


            {% comment %}
              -----------------------------------------------
              COLOR / COLOUR

              Color is intentionally rendered first to match
              the supplied Figma design regardless of the
              Shopify product option order.
              -----------------------------------------------
            {% endcomment %}

            {% for option in product.options_with_values %}

              {% assign option_name = option.name | downcase %}

              {% if option_name contains 'color' or option_name contains 'colour' %}

                {% assign option_index = option.position | minus: 1 %}
                {% assign selected_value = selected_variant.options[option_index] %}

                <div
                  class="ee-product-option"
                  data-ee-option-group
                  data-ee-option-position="{{ option.position }}"
                >

                  <div class="ee-product-option__label">
                    {{ option.name }}
                  </div>


                  <div class="ee-product-option__colors">

                    {% for value in option.values %}

                      {% assign swatch_color = value | downcase %}

                      <button
                        type="button"
                        class="
                          ee-product-option__color
                          {% if value == selected_value %}
                            is-selected
                          {% endif %}
                        "
                        data-ee-option-value="{{ value | escape }}"
                        style="--ee-swatch: {{ swatch_color }};"
                      >
                        {{ value }}
                      </button>

                    {% endfor %}

                  </div>

                </div>

              {% endif %}

            {% endfor %}


            {% comment %}
              -----------------------------------------------
              SIZE + OTHER OPTIONS

              All non-color options appear after Color.
              -----------------------------------------------
            {% endcomment %}

            {% for option in product.options_with_values %}

              {% assign option_name = option.name | downcase %}

              {% unless option_name contains 'color' or option_name contains 'colour' %}

                {% assign option_index = option.position | minus: 1 %}
                {% assign selected_value = selected_variant.options[option_index] %}

                <div
                  class="ee-product-option"
                  data-ee-option-group
                  data-ee-option-position="{{ option.position }}"
                >

                  <div class="ee-product-option__label">
                    {{ option.name }}
                  </div>


                  <select class="ee-product-option__select">

                    {% if option_name contains 'size' %}

                      <option
                        value=""
                        selected
                        disabled
                      >
                        Choose your size
                      </option>

                    {% endif %}


                    {% for value in option.values %}

                      <option
                        value="{{ value | escape }}"

                        {% unless option_name contains 'size' %}
                          {% if value == selected_value %}
                            selected
                          {% endif %}
                        {% endunless %}
                      >
                        {{ value }}
                      </option>

                    {% endfor %}

                  </select>

                </div>

              {% endunless %}

            {% endfor %}

          </div>


          {% comment %}
            =================================================
            ADD TO CART
            =================================================
          {% endcomment %}

          <button
            type="button"
            class="ee-product-modal__add"
            data-ee-add-to-cart
            data-variant-id="{{ selected_variant.id }}"
            {% unless selected_variant.available %}
              disabled
            {% endunless %}
          >

            {% if selected_variant.available %}

              ADD TO CART
              <span>→</span>

            {% else %}

              SOLD OUT

            {% endif %}

          </button>


          <div
            class="ee-product-modal__status"
            data-ee-cart-status
            aria-live="polite"
          ></div>


          {% comment %}
            =================================================
            PRODUCT VARIANT DATA FOR VANILLA JAVASCRIPT
            =================================================
          {% endcomment %}

          <script
            type="application/json"
            class="ee-product-modal__variants"
          >
            [
              {% for variant in product.variants %}
                {
                  "id": {{ variant.id | json }},
                  "available": {{ variant.available | json }},
                  "options": {{ variant.options | json }},
                  "price": {{ variant.price | money | json }}
                }
                {% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          </script>

        </div>

      </div>

    {% endif %}

  {% endfor %}

</section>


<script
  src="{{ 'ecomexperts-assessment.js' | asset_url }}"
  defer
></script>


{% schema %}
{
  "name": "EcomExperts Product Grid",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },

    {
      "type": "header",
      "content": "Grid products"
    },

    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },

    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },

    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },

    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },

    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },

    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    },
    {
  "type": "product",
  "id": "bonus_product",
  "label": "Bonus product"
}

  ],

  "presets": [
    {
      "name": "EcomExperts Product Grid"
    }
  ]
}
{% endschema %}