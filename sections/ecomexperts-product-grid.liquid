{{ 'ecomexperts-assessment.css' | asset_url | stylesheet_tag }}

<section class="ee-product-grid">

  <h2 class="ee-product-grid__heading">
    {{ section.settings.heading }}
  </h2>

  {% if section.settings.collection != blank %}

    <div class="ee-product-grid__items">

      {% for product in section.settings.collection.products limit: 6 %}

  {% assign selected_variant = product.selected_or_first_available_variant %}

  <div class="ee-product-grid__item">

    {% if product.featured_image != blank %}
      {{
        product.featured_image
        | image_url: width: 900
        | image_tag:
          class: 'ee-product-grid__image',
          loading: 'lazy',
          alt: product.title
      }}
    {% endif %}

    {% case forloop.index %}
      {% when 1 %}
        {% assign hotspot_x = '61.8%' %}
        {% assign hotspot_y = '56.1%' %}

      {% when 2 %}
        {% assign hotspot_x = '84.6%' %}
        {% assign hotspot_y = '52.5%' %}

      {% when 3 %}
        {% assign hotspot_x = '63%' %}
        {% assign hotspot_y = '21%' %}

      {% when 4 %}
        {% assign hotspot_x = '72.2%' %}
        {% assign hotspot_y = '18.5%' %}

      {% when 5 %}
        {% assign hotspot_x = '51.6%' %}
        {% assign hotspot_y = '25.9%' %}

      {% when 6 %}
        {% assign hotspot_x = '76.3%' %}
        {% assign hotspot_y = '39.4%' %}
    {% endcase %}

    <button
      type="button"
      class="ee-product-grid__hotspot"
      aria-label="View {{ product.title }}"
      data-ee-open-modal="ee-product-modal-{{ section.id }}-{{ product.id }}"
      style="
        --ee-hotspot-x: {{ hotspot_x }};
        --ee-hotspot-y: {{ hotspot_y }};
      "
    >
      +
    </button>

  </div>

      {% endfor %}

    </div>


    {% comment %}
      Product quick-view modals
    {% endcomment %}

    {% for product in section.settings.collection.products limit: 6 %}

      {% assign selected_variant = product.selected_or_first_available_variant %}

      <div
        class="ee-product-modal"
        id="ee-product-modal-{{ section.id }}-{{ product.id }}"
        hidden
      >

        <button
          type="button"
          class="ee-product-modal__overlay"
          aria-label="Close product"
          data-ee-close-modal
        ></button>

        <div
          class="ee-product-modal__dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="ee-product-title-{{ product.id }}"
        >

          <button
            type="button"
            class="ee-product-modal__close"
            aria-label="Close"
            data-ee-close-modal
          >
            ×
          </button>

          <div class="ee-product-modal__top">

            {% if product.featured_image != blank %}

              {{
                product.featured_image
                | image_url: width: 400
                | image_tag:
                  class: 'ee-product-modal__image',
                  loading: 'lazy',
                  alt: product.title
              }}

            {% endif %}

            <div class="ee-product-modal__info">

              <h3
                class="ee-product-modal__title"
                id="ee-product-title-{{ product.id }}"
              >
                {{ product.title }}
              </h3>

              <div
                class="ee-product-modal__price"
                data-ee-product-price
              >
                {{ selected_variant.price | money }}
              </div>

              <div class="ee-product-modal__description">
                {{ product.description | strip_html | truncate: 140 }}
              </div>

            </div>

          </div>


          <div class="ee-product-modal__options">

  {% comment %}
    Render COLOR first regardless of Shopify option order
  {% endcomment %}

  {% for option in product.options_with_values %}

    {% assign option_name = option.name | downcase %}

    {% if option_name contains 'color' or option_name contains 'colour' %}

      {% assign option_index = option.position | minus: 1 %}
      {% assign selected_value = selected_variant.options[option_index] %}

      <div
        class="ee-product-option"
        data-ee-option-group
      >

        <div class="ee-product-option__label">
          {{ option.name }}
        </div>

        <div class="ee-product-option__colors">

          {% for value in option.values %}

            {% assign swatch_color = value | downcase %}

            <button
              type="button"
              class="ee-product-option__color{% if value == selected_value %} is-selected{% endif %}"
              data-ee-option-value="{{ value | escape }}"
              style="--ee-swatch: {{ swatch_color }};"
            >
              {{ value }}
            </button>

          {% endfor %}

        </div>

      </div>

    {% endif %}

  {% endfor %}


  {% comment %}
    Render SIZE and all other options after Color
  {% endcomment %}

  {% for option in product.options_with_values %}

    {% assign option_name = option.name | downcase %}

    {% unless option_name contains 'color' or option_name contains 'colour' %}

      {% assign option_index = option.position | minus: 1 %}
      {% assign selected_value = selected_variant.options[option_index] %}

      <div
        class="ee-product-option"
        data-ee-option-group
      >

        <div class="ee-product-option__label">
          {{ option.name }}
        </div>

        <select class="ee-product-option__select">

          {% for value in option.values %}

            <option
              value="{{ value | escape }}"
              {% if value == selected_value %}selected{% endif %}
            >
              {{ value }}
            </option>

          {% endfor %}

        </select>

      </div>

    {% endunless %}

  {% endfor %}

</div>


          <button
            type="button"
            class="ee-product-modal__add"
            data-ee-add-to-cart
            data-variant-id="{{ selected_variant.id }}"
            {% unless selected_variant.available %}disabled{% endunless %}
          >
            {% if selected_variant.available %}
              ADD TO CART
              <span>→</span>
            {% else %}
              SOLD OUT
            {% endif %}
          </button>

          <div
            class="ee-product-modal__status"
            data-ee-cart-status
            aria-live="polite"
          ></div>


          <script
            type="application/json"
            class="ee-product-modal__variants"
          >
            [
              {% for variant in product.variants %}
                {
                  "id": {{ variant.id | json }},
                  "available": {{ variant.available | json }},
                  "options": {{ variant.options | json }},
                  "price": {{ variant.price | money | json }}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          </script>

        </div>

      </div>

    {% endfor %}

  {% endif %}

</section>

<script
  src="{{ 'ecomexperts-assessment.js' | asset_url }}"
  defer
></script>


{% schema %}
{
  "name": "EcomExperts Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "EcomExperts Product Grid"
    }
  ]
}
{% endschema %}