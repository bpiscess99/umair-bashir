{{ 'ecomexperts-assessment.css' | asset_url | stylesheet_tag }}

<section class="ee-banner">

  <!-- Top navigation strip -->
  <div class="ee-banner__top">

    <div class="ee-banner__logo">
      {{ section.settings.logo_text }}
    </div>

    <div class="ee-banner__message">
      {{ section.settings.top_message }}
    </div>

    <a
      href="{{ section.settings.top_button_link | default: '#' }}"
      class="ee-button ee-button--yellow"
    >
      <span class="ee-button__text">
        {{ section.settings.top_button_text }}
      </span>

      <span class="ee-button__arrow" aria-hidden="true">→</span>
    </a>

  </div>

  <!-- Main 1440 × 780 hero -->
  <div class="ee-banner__hero">

    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2880
        | image_tag:
          class: 'ee-banner__image',
          loading: 'eager'
      }}
    {% endif %}

    <div class="ee-banner__content">

      <h1 class="ee-banner__heading">
        {{ section.settings.heading }}
      </h1>

      <div class="ee-banner__description">
        {{ section.settings.description }}
      </div>

      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="ee-button ee-button--black"
      >
        <span class="ee-button__text">
          {{ section.settings.button_text }}
        </span>

        <span class="ee-button__arrow" aria-hidden="true">→</span>
      </a>

    </div>

    <!-- This belongs at the bottom of the hero -->
    <div class="ee-banner__bottom-text">
      {{ section.settings.bottom_text }}
    </div>

  </div>

</section>

{% schema %}
{
  "name": "EcomExperts Banner",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Top message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top button link"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Banner background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "EcomExperts Banner"
    }
  ]
}
{% endschema %}